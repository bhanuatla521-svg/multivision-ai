# ============================================================
# MultiVision AI — .gitignore
# ============================================================

# --- Secrets & Environment ---
.env
*.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd
.Python
pip-wheel-metadata/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Data & Database ---
data/
*.db
*.sqlite
*.sqlite3

# --- Logs ---
logs/
*.log
*.log.*

# --- Uploads & Cache ---
uploads/
.cache/
*.cache
*.tmp
*.bak

# --- Node / Frontend (if any) ---
node_modules/
.npm

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Test artifacts ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Docker ---
*.pid
