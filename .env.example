# =========================================================================
# MULTIVISION AI — ENVIRONMENT CONFIGURATION (.env.example)
# Multimodal Intelligence, Unified.
#
# Copy this file to .env before running:
# cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
# Application Mode & Port Configuration
# -------------------------------------------------------------------------
# Set DEMO_MODE=true to run without any API keys with deterministic demo outputs.
DEMO_MODE=true
AI_PROVIDER=demo
PORT=7000
HOST=127.0.0.1
AUTH_ENABLED=false
LOCALHOST_BYPASS=true

# -------------------------------------------------------------------------
# AI Model Provider Credentials (Optional — Demo Mode works without these)
# -------------------------------------------------------------------------

# Google Gemini (Free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# OpenRouter Unified Gateway (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Groq Ultra-Fast Inference (https://console.groq.com/keys)
GROQ_API_KEY=

# Ollama Local Model Server (Default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# -------------------------------------------------------------------------
# Web Search & Research Services (Optional)
# -------------------------------------------------------------------------
SEARXNG_INSTANCE=http://localhost:8080

# -------------------------------------------------------------------------
# Media & Image Generation Providers (Optional)
# -------------------------------------------------------------------------
# Hugging Face Inference API
HF_API_KEY=
# NVIDIA NIM
NVIDIA_API_KEY=
# Stability AI
STABILITY_API_KEY=
