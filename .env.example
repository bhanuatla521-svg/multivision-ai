# MultiVision AI — Environment Configuration
# Copy this file to .env and fill in your API keys.

# ============================================================
# LLM Configuration
# ============================================================
LLM_HOST=localhost
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# LM_STUDIO_URL=http://host.docker.internal:1234
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# Search & Web
# ============================================================
SEARXNG_INSTANCE=http://localhost:8080

# ============================================================
# Auth & Security
# ============================================================
LOCALHOST_BYPASS=true
# MULTIVISION_ADMIN_PASSWORD=change_me_before_first_boot

# ============================================================
# Hugging Face (Image Generation — Stable Diffusion, FLUX, etc.)
# ============================================================
# Get your free key at: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here
HF_TOKEN=your_huggingface_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================================
# NVIDIA NIM (Image Generation — SDXL, Flux, SD3)
# ============================================================
# Get your free key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# ============================================================
# Google Gemini
# ============================================================
# Get your free key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# Stability AI
# ============================================================
# Get your key at: https://platform.stability.ai
# STABILITY_API_KEY=your_stability_api_key_here
